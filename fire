    label.Text = text
    label.TextColor3 = color or Color3.new(1, 1, 1)
    label.Font = Enum.Font.Code
    label.TextSize = 12
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextWrapped = true
    label.Parent = scroll
    scroll.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y)
end

local function cloneAllTools()
    status.Text = "Status: Mencuri aset dari Workspace & RepStorage..."
    local count = 0
    
    local sources = {Workspace, ReplicatedStorage}
    for _, source in ipairs(sources) do
        for _, obj in pairs(source:GetDescendants()) do
            if obj:IsA("Tool") or obj:IsA("HopperBin") then
                local cloned = obj:Clone()
                cloned.Parent = backpack
                count = count + 1
                log("[+] Cloned: " .. obj.Name, Color3.fromRGB(100, 255, 100))
            end
        end
    end
    
    status.Text = "Status: " .. count .. " item di-clone ke Backpack."
    return count
end

local function spoofAllRemotes()
    status.Text = "Status: Memaksa server via Remote Spam..."
    local fired = 0
    
    for _, remote in pairs(ReplicatedStorage:GetDescendants()) do
        if remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction") then
            local name = remote.Name:lower()
            -- Cari remote yang berhubungan dengan inventori, equip, atau klaim
            if string.find(name, "equip") or string.find(name, "give") or 
               string.find(name, "claim") or string.find(name, "buy") or
               string.find(name, "inventory") or string.find(name, "spawn") or
               string.find(name, "unlock") then
                
                -- Brute-force argument
                local payloads = {
                    {player},
                    {player.UserId},
                    {true},
                    {1},
                    {"All"},
                    {"*"},
                    {player, true},
                    {player.UserId, "All"}
                }
                
                for _, args in ipairs(payloads) do
                    pcall(function()
                        if remote:IsA("RemoteEvent") then
                            remote:FireServer(unpack(args))
                        else
                            remote:InvokeServer(unpack(args))
                        end
                    end)
                end
                fired = fired + 1
                log("[>] Spammed: " .. remote.Name, Color3.fromRGB(255, 200, 100))
            end
        end
    end
    
    status.Text = "Status: " .. fired .. " remote di-spam ke server."
end

local function forceEquip()
    status.Text = "Status: Memaksa karakter memakai item..."
    local char = player.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            for _, tool in pairs(backpack:GetChildren()) do
                if tool:IsA("Tool") then
                    pcall(function()
                        hum:EquipTool(tool)
                    end)
                end
            end
        end
    end
    status.Text = "Status: Equip dipaksa. Cek tangan karakter lu."
end

